# ==============================================================================
# BIS COMPLIANCE COPILOT - ENVIRONMENT CONFIGURATION (template)
# Copy to .env and fill in real values. .env is git-ignored.
# ==============================================================================

FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
HOST=127.0.0.1
SECRET_KEY=change-me-to-a-long-random-string

# Database
DATABASE_URL=sqlite:///bis_compliance.db

# OpenAI (optional — blank = built-in offline RAG fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google Gemini (free tier) - fallback when OpenAI has no credit.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Primary / admin user
PRIMARY_USER_EMAIL=you@example.com
PRIMARY_USER_NAME=Your Name
PRIMARY_USER_COMPANY=Your Company
PRIMARY_USER_PASSWORD=change-me

# ==============================================================================
# SMTP EMAIL (Gmail) - Registration OTP verification
# SMTP_USER  = full Gmail address
# SMTP_PASSWORD = 16-char Gmail App Password (Account > Security > 2-Step
#                 Verification > App passwords). NOT your normal password.
# Leave SMTP_USER / SMTP_PASSWORD blank to run in dev mode (code printed to
# the server console instead of emailed).
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=BIS Compliance Copilot
SMTP_FROM=
OTP_EXP_MINUTES=10

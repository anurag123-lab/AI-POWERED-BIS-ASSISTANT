FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
HOST=127.0.0.1
SECRET_KEY=bis_copilot_secret_key_sih2026_ianurag014

# Database Configuration
DATABASE_URL=sqlite:///bis_compliance.db

# OpenAI API Key & Host Configuration
# Place your OpenAI API Key below to enable live OpenAI LLM completions.
# If left blank, the app runs on the built-in Grounded Offline RAG Fallback Engine!
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Primary Registered User / Admin Credentials
PRIMARY_USER_EMAIL=ianurag014@gmail.com
PRIMARY_USER_NAME=Anurag Indur
PRIMARY_USER_COMPANY=Indur Technologies / Manufacturer
PRIMARY_USER_PASSWORD=password123

# ==============================================================================
# SMTP EMAIL (Gmail) - Registration OTP Verification
# ------------------------------------------------------------------------------
# SMTP_USER must be a full Gmail address. SMTP_PASSWORD must be a 16-character
# Gmail "App Password" (Google Account > Security > 2-Step Verification >
# App passwords), NOT your normal Google password.
# If SMTP_USER / SMTP_PASSWORD are left blank the app runs in dev mode and
# prints the verification code to the server console instead of emailing it.
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=BIS Compliance Copilot
SMTP_FROM=
OTP_EXP_MINUTES=10
